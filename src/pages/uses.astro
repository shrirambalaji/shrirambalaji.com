---
import BaseLayout from "../layouts/BaseLayout.astro";
import { uses } from "../lib/site";

const sectionLabelClass =
  "mb-[0.35rem] border-b border-rule pb-[0.35rem] text-[0.875rem] font-[460] tracking-[-0.00563rem] text-muted-soft";
const bulletItemClass =
  "relative pl-4 text-[0.875rem] font-[460] leading-[1.4rem] tracking-[-0.00563rem] text-muted before:absolute before:left-0 before:top-[0.5rem] before:h-[0.25rem] before:w-[0.25rem] before:rounded-full before:bg-ghostindigo-300";
---

<BaseLayout currentPath="/uses" title="Uses">
  <section class="grid gap-8 pt-0.5">
    <section>
      <h2 class={sectionLabelClass}>Hardware</h2>
      <ul class="grid gap-2 pt-[0.35rem]">
        {uses.hardware.map((item: string) => <li class={bulletItemClass}>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2 class={sectionLabelClass}>Applications</h2>
      <ul class="grid gap-2 pt-[0.35rem]">
        {uses.apps.map((item: string) => <li class={bulletItemClass}>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2 class={sectionLabelClass}>Typography</h2>
      <ul class="grid gap-2 pt-[0.35rem]">
        {uses.typography.map((item: string) => <li class={bulletItemClass}>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2 class={sectionLabelClass}>VS Code Extensions</h2>
      <ul class="grid gap-2 pt-[0.35rem]">
        {uses.extensions.map((item: string) => <li class={bulletItemClass}>{item}</li>)}
      </ul>
    </section>
  </section>
</BaseLayout>
