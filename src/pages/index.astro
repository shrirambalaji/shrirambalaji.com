---
import { getEntry, render } from "astro:content";
import Projects from "../components/projects.astro";
import Talks from "../components/talks.astro";
import BaseLayout from "../layouts/base-layout.astro";
import { getRecentBlogPosts } from "../lib/blog-rss";
import { featuredProjects, openSourceContributions, recentTalks, siteSettings, socialLinks } from '../lib/site';
import type { Project, SocialLink } from '../lib/site';
import {
  createHomepageStructuredData,
  serializeStructuredData,
} from "../lib/structured-data";

const introEntry = await getEntry("home", "intro");

if (!introEntry) {
  throw new Error("Missing homepage intro content entry.");
}

const { Content: Intro } = await render(introEntry);
const homepageProjects = featuredProjects
  .filter((project: Project) => project.title !== "Advent of Code in Rust")
  .slice(0, 4);
const writingLinks = await getRecentBlogPosts(4);
const blogDateFormatter = new Intl.DateTimeFormat("en-US", {
  day: "numeric",
  month: "short",
  timeZone: "UTC",
  year: "numeric",
});
const sectionLabelClass =
  "mb-[0.35rem] border-b border-rule pb-[0.35rem] text-[0.875rem] font-[460] tracking-[-0.00563rem] text-muted-soft";
const detailLinkClass =
  "group -mx-2 flex items-start justify-between gap-4 rounded-2xl px-2 py-3 transition-colors duration-150 max-md:mx-0 max-md:flex-col max-md:items-start max-md:px-0";
const detailCopyHeadingClass =
  "m-0 hover-accent-text text-[0.9375rem] font-[500] leading-[1.55rem] tracking-[-0.003em] text-ghostindigo-900 transition-colors duration-150 md:text-[0.875rem] md:leading-[1.4rem] md:tracking-[-0.00563rem]";
const detailCopyBodyClass =
  "m-0 text-pretty text-[0.9375rem] font-[460] leading-[1.6rem] tracking-[-0.003em] text-muted md:text-[0.875rem] md:leading-[1.5rem] md:tracking-[-0.00563rem]";
const detailCopyClasses = "grid min-w-0 gap-[0.2rem]";
const writingDateClass =
  "mb-[0.38rem] text-[0.75rem] font-[500] leading-[1.1rem] tracking-[-0.01em] text-muted-soft";
const writingTitleClass = "m-0 inline hover-inline-title";
const writingArrowClass =
  "hover-accent-arrow inline-flex w-[0.8rem] shrink-0 justify-center text-ghostindigo-700 opacity-0 transition-opacity duration-150 group-hover:opacity-100";
const writingTitleRowClass = "inline-flex items-center gap-[0.2rem]";
const writingCtaArrowClass =
  "inline-flex w-[0.8rem] shrink-0 justify-center text-ghostindigo-700 transition-transform duration-150 group-hover:translate-x-[0.12rem]";
const homepageStructuredData = serializeStructuredData(
  createHomepageStructuredData(siteSettings)
);
---

<BaseLayout currentPath="/" structuredData={homepageStructuredData}>
  <article id="about" class="grid max-w-none scroll-mt-24 gap-[0.85rem] md:max-w-[70ch]">
    <div
      class="relative h-23 w-23 overflow-hidden rounded-[0.9rem] border border-[rgba(59,59,84,0.14)] shadow-soft"
    >
      <img
        class="absolute left-1/2 top-[-0.55rem] h-auto -translate-x-1/2"
        style="width: 165%; max-width: none;"
        src="/images/shriram-balaji.jpg"
        alt="Shriram Balaji"
        width="853"
        height="1280"
        loading="eager"
        decoding="async"
      >
    </div>

    <div
      class="intro-prose grid gap-[0.7rem] [&_p]:m-0 [&_p]:max-w-none [&_p]:text-pretty [&_p]:text-[0.9375rem] [&_p]:font-[460] [&_p]:leading-[1.68rem] [&_p]:tracking-normal [&_p]:text-ghostindigo-800 md:[&_p]:text-[0.875rem] md:[&_p]:leading-[1.6rem] md:[&_p]:tracking-[-0.00563rem]"
    >
      <Intro />
    </div>

    <p class="m-0 text-[0.9375rem] font-[460] leading-[1.68rem] tracking-normal text-ghostindigo-800 md:text-[0.875rem] md:leading-[1.6rem] md:tracking-[-0.00563rem]">
      <span>Find me on </span>
      {socialLinks.map((link: SocialLink, index: number) => (
          <>
            <a
              class="basic-link transition-colors duration-150"
              href={link.href}
              target={link.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={link.href.startsWith("mailto:") ? undefined : "noreferrer"}
            >
              {link.label}
            </a>
            {index < socialLinks.length - 1 ? <span>, </span> : null}
          </>
        ))}
      <span>.</span>
    </p>
  </article>

  <section id="projects" class="grid scroll-mt-24 gap-7">
    <div class="grid gap-[0.35rem]">
      <h2 class={sectionLabelClass}>Projects</h2>
      <Projects items={homepageProjects} compact />
    </div>

    <div class="grid gap-[0.35rem]">
      <h2 class={sectionLabelClass}>Recent Open Source Contributions</h2>
      <Projects items={openSourceContributions} compact />
    </div>
  </section>

  <section id="writing" class="grid gap-[0.35rem]">
    <h2 class={sectionLabelClass}>Writing</h2>
    <ul class="detail-list m-0 list-none p-0">
      {writingLinks.map((item, index) => (
          <li style={`--item-index:${index};`}>
            <a
              class={detailLinkClass}
              href={item.href}
            >
              <div class="min-w-0">
                <p class={writingDateClass}>
                  {blogDateFormatter.format(new Date(item.publishedTime))}
                </p>
                <div class={detailCopyClasses}>
                  <h2 class={detailCopyHeadingClass}>
                    <span class={writingTitleRowClass}>
                      <span class={writingTitleClass}>{item.title}</span>
                      <span class={writingArrowClass} aria-hidden="true">
                        ↗
                      </span>
                    </span>
                  </h2>
                  <p class={detailCopyBodyClass}>{item.description}</p>
                </div>
              </div>
            </a>
          </li>
        ))}
      <li>
        <a
          class={detailLinkClass}
          href="/writing"
        >
          <div class="min-w-0">
            <h2 class={detailCopyHeadingClass}>
              <span class={writingTitleRowClass}>
                <span class={writingTitleClass}>Read all posts</span>
                <span class={writingCtaArrowClass} aria-hidden="true">→</span>
              </span>
            </h2>
          </div>
        </a>
      </li>
    </ul>
  </section>

  <section id="talks" class="grid scroll-mt-24 gap-[0.35rem]">
    <h2 class={sectionLabelClass}>Talks</h2>
    <Talks items={recentTalks} />
  </section>
</BaseLayout>
