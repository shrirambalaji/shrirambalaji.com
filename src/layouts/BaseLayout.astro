---
import { MobileNav } from "../components/MobileNav";
import { navItems, siteMeta, socialLinks } from "../data/site";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  currentPath: string;
};

const {
  title = siteMeta.title,
  description = siteMeta.description,
  currentPath,
} = Astro.props;

const pageTitle =
  title === siteMeta.title ? title : `${title} · ${siteMeta.title}`;
const navLinkClasses =
  "site-nav-link text-sm font-medium tracking-[-0.00563rem]";
const footerLinkClasses =
  "footer-link transition-colors duration-150 hover:text-ghostindigo-900";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteMeta.url}${currentPath}`} />
    <meta property="og:image" content={`${siteMeta.url}/og-image.png`} />
    <link rel="icon" href="/favicons/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicons/favicon-32x32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
  </head>
  <body
    class="min-h-screen bg-white font-sans text-base leading-[1.25] text-ghostindigo-800"
  >
    <div
      class="mx-auto max-w-[36.375rem] px-6 pb-10 pt-4 md:px-4 md:pb-[3.25rem] md:pt-[2.9rem] xl:max-w-[44.5rem]"
    >
      <div class="scroll-blur" aria-hidden="true"></div>
      <header
        class="site-intro-fade site-intro-fade-header sticky top-0 z-20 bg-transparent py-[0.65rem]"
      >
        <div class="flex items-center justify-between gap-8 py-1">
          <a
            class="text-sm font-[650] tracking-[-0.012em] text-ghostindigo-900"
            href="/"
          >
            Shriram Balaji
          </a>

          <nav class="hidden min-[700px]:block" aria-label="Primary">
            <ul class="m-0 flex list-none items-center gap-[1.35rem] p-0">
              {
                navItems.map((item) => {
                  const active =
                    !item.external &&
                    ((currentPath === "/" && item.href === "/#about") ||
                      (currentPath === "/uses" && item.href === "/uses"));
                  const section =
                    item.href === "/uses"
                      ? "uses"
                      : item.href.startsWith("/#")
                        ? item.href.slice(2)
                        : undefined;
                  return (
                    <li>
                      <a
                        href={item.href}
                        class:list={[
                          navLinkClasses,
                        ]}
                        aria-current={active ? (section === "uses" ? "page" : "location") : undefined}
                        data-nav-link={section ? "true" : undefined}
                        data-section={section}
                        target={item.external ? "_blank" : undefined}
                        rel={item.external ? "noreferrer" : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </nav>

          <MobileNav client:load currentPath={currentPath} items={navItems} />
        </div>
      </header>

      <main class="page-content grid gap-9">
        <slot />
      </main>

      <footer class="site-intro-fade site-intro-fade-footer pt-7">
        <div class="mb-5 h-px w-[3.125rem] bg-rule"></div>
        <p
          class="m-0 text-[0.875rem] font-[460] leading-[1.4rem] tracking-[-0.00563rem] text-muted-soft"
        >
          <span>Find me on </span>
          {
            socialLinks.map((link, index) => (
              <>
                <a
                  class={footerLinkClasses}
                  href={link.href}
                  target={
                    link.href.startsWith("mailto:") ? undefined : "_blank"
                  }
                  rel={
                    link.href.startsWith("mailto:") ? undefined : "noreferrer"
                  }
                >
                  {link.label}
                </a>
                {index < socialLinks.length - 1 ? <span>, </span> : null}
              </>
            ))
          }
          <span>. View source on </span>
          <a
            class={footerLinkClasses}
            href="https://github.com/shrirambalaji/shrirambalaji.com"
            target="_blank"
            rel="noreferrer"
          >
            GitHub
          </a>
          <span>.</span>
        </p>
      </footer>
    </div>
    <script is:inline>
      (() => {
        const links = Array.from(
          document.querySelectorAll("[data-nav-link='true']")
        );

        if (links.length === 0) {
          return;
        }

        const setActive = (section) => {
          for (const link of links) {
            const target = link.getAttribute("data-section");
            if (!target) continue;

            if (target === section) {
              link.setAttribute(
                "aria-current",
                target === "uses" ? "page" : "location"
              );
            } else {
              link.removeAttribute("aria-current");
            }
          }
        };

        if (window.location.pathname === "/uses") {
          setActive("uses");
          return;
        }

        if (window.location.pathname !== "/") {
          return;
        }

        const sections = ["about", "projects", "talks"]
          .map((id) => document.getElementById(id))
          .filter(Boolean);

        const resolveActiveSection = () => {
          const lastSection = sections.at(-1);
          const scrolledToBottom =
            window.innerHeight + window.scrollY >=
            document.documentElement.scrollHeight - 4;

          if (scrolledToBottom && lastSection) {
            setActive(lastSection.id);
            return;
          }

          let active = "about";
          const offset = 140;

          for (const section of sections) {
            if (section.getBoundingClientRect().top <= offset) {
              active = section.id;
            }
          }

          setActive(active);
        };

        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            resolveActiveSection();
            ticking = false;
          });
        };

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("hashchange", resolveActiveSection);
        resolveActiveSection();
      })();
    </script>
  </body>
</html>
