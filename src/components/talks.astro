---
import Presentation from "@lucide/astro/icons/presentation";
import TvMinimalPlay from "@lucide/astro/icons/tv-minimal-play";
import type { Talk } from "../lib/site";

interface Props {
  items: Talk[];
}

const { items } = Astro.props;
type TalkAction = Talk["actions"][number];
const listClasses = "detail-list m-0 list-none p-0";
const itemClasses = "py-3";
const copyClasses = "grid min-w-0 gap-[0.2rem]";
const titleClasses =
  "m-0 min-w-0 text-[0.9375rem] font-[500] leading-[1.6rem] tracking-[-0.003em] text-ghostindigo-900 md:text-[0.875rem] md:leading-[1.5rem] md:tracking-[-0.00563rem]";
const descriptionClasses =
  "m-0 text-pretty text-[0.9375rem] font-[460] leading-[1.6rem] tracking-[-0.003em] text-muted md:text-[0.875rem] md:leading-[1.5rem] md:tracking-[-0.00563rem]";
const eventClasses =
  "text-[0.9375rem] font-[460] leading-[1.6rem] tracking-[-0.003em] text-muted-soft md:text-[0.875rem] md:leading-[1.5rem] md:tracking-[-0.00563rem]";
const eventDotClasses = "inline-block text-[1rem] leading-none text-muted-soft";
const actionClasses =
  "group inline-grid grid-cols-[13px_auto] items-center gap-x-[0.45rem] text-[0.72rem] font-[460] leading-[1.1rem] tracking-[-0.003rem] text-muted";
const actionTextRowClasses = "inline-flex items-center gap-[0.2rem]";
const actionLabelClasses =
  "talk-action-label hover-accent-text relative inline-block leading-[1.1rem] after:absolute after:left-0 after:right-0 after:bottom-[-0.08rem] after:h-px";
const actionIconWrapClasses =
  "flex h-[13px] w-[13px] items-center justify-center text-muted transition-colors duration-150 ease-out";
const actionIconClasses = "block h-[13px] w-[13px] shrink-0";
const watchIconWrapClasses = `${actionIconWrapClasses} group-hover:text-rose-400`;
const slidesIconWrapClasses = `${actionIconWrapClasses} group-hover:text-sky-400`;
const actionArrowClasses =
  "hover-accent-arrow inline-block w-[0.8rem] text-center text-[0.95em] leading-none text-ghostindigo-700 opacity-0 transition-opacity duration-150 group-hover:opacity-100";
---

<ul class={listClasses}>
  {items.map((talk, index) => (
      <li style={`--item-index:${index};`}>
        <div class={itemClasses}>
          <div class="w-full min-w-0">
            <div class={copyClasses}>
              <h2 class={titleClasses}>
                <span>{talk.title}</span>
                <span aria-hidden="true" class={`${eventDotClasses} mx-[0.18rem]`}>
                  ·
                </span>
                <span class={eventClasses}>{talk.event}</span>
              </h2>
              <p class={descriptionClasses}>{talk.description}</p>
            </div>
            <div class="mt-[0.45rem] grid auto-cols-max grid-flow-col justify-start gap-x-[0.9rem] gap-y-2 max-md:mt-[0.38rem] max-md:gap-x-3">
              {talk.actions.map((action: TalkAction) => (
                <a
                  class={actionClasses}
                  href={action.href}
                  rel={action.href.startsWith("/") ? undefined : "noreferrer"}
                  target={action.href.startsWith("/") ? undefined : "_blank"}
                >
                  <span
                    aria-hidden="true"
                    class={
                      action.icon === "watch"
                        ? watchIconWrapClasses
                        : slidesIconWrapClasses
                    }
                  >
                    {action.icon === "watch" ? (
                      <TvMinimalPlay
                        aria-hidden="true"
                        class={actionIconClasses}
                        size={13}
                        stroke-width={2}
                      />
                    ) : (
                      <Presentation
                        aria-hidden="true"
                        class={actionIconClasses}
                        size={13}
                        stroke-width={2}
                      />
                    )}
                  </span>
                  <span class={actionTextRowClasses}>
                    <span class={actionLabelClasses}>{action.label}</span>
                    <span aria-hidden="true" class={actionArrowClasses}>
                      ↗
                    </span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </li>
    ))}
</ul>
