---
import Presentation from "@lucide/astro/icons/presentation";
import TvMinimalPlay from "@lucide/astro/icons/tv-minimal-play";
import type { Talk } from "../data/site";

type Props = {
  items: Talk[];
};

const { items } = Astro.props;
const listClasses = "detail-list m-0 list-none p-0";
const itemClasses = "py-3";
const titleClasses =
  "m-0 min-w-0 flex flex-wrap items-baseline gap-x-[0.35rem] gap-y-[0.08rem] text-[0.875rem] font-[500] leading-[1.4rem] tracking-[-0.00563rem] text-ghostindigo-900";
const descriptionClasses =
  "m-0 text-[0.875rem] font-[460] leading-[1.5rem] tracking-[-0.00563rem] text-muted";
const eventClasses =
  "text-[0.875rem] font-[460] leading-[1.4rem] tracking-[-0.00563rem] text-muted-soft";
const eventDotClasses = "text-muted-soft";
const actionClasses =
  "group grid grid-cols-[13px_auto_0.7rem] items-center gap-x-[0.45rem] text-[0.72rem] font-[460] leading-[1.1rem] tracking-[-0.003rem] text-muted";
const actionLabelClasses =
  "talk-action-label hover-accent-text relative inline-block leading-[1.1rem] after:absolute after:left-0 after:right-0 after:bottom-[-0.08rem] after:h-px";
const actionIconWrapClasses =
  "flex h-[13px] w-[13px] items-center justify-center text-muted transition-colors duration-150 ease-out";
const actionIconClasses = "block h-[13px] w-[13px] shrink-0";
const watchIconWrapClasses = `${actionIconWrapClasses} group-hover:text-red-500`;
const slidesIconWrapClasses = `${actionIconWrapClasses} group-hover:text-yellow-500`;
---

<ul class={listClasses}>
  {
    items.map((talk, index) => (
      <li style={`--item-index:${index};`}>
        <div class={itemClasses}>
          <div class="min-w-0 w-full">
            <h2 class={titleClasses}>
              <span>{talk.title}</span>
              <span class={eventDotClasses} aria-hidden="true">
                ·
              </span>
              <span class={eventClasses}>{talk.event}</span>
            </h2>
            <p class={descriptionClasses}>{talk.description}</p>
            <div class="mt-[0.45rem] grid auto-cols-max grid-flow-col justify-start gap-x-[0.9rem] gap-y-2 max-md:mt-[0.38rem] max-md:gap-x-3">
              <a
                class={actionClasses}
                href={talk.href}
                target="_blank"
                rel="noreferrer"
              >
                <span class={watchIconWrapClasses} aria-hidden="true">
                  <TvMinimalPlay
                    aria-hidden="true"
                    size={13}
                    stroke-width={2}
                    class={actionIconClasses}
                  />
                </span>
                <span class={actionLabelClasses}>Watch</span>
                <span
                  class="hover-accent-arrow inline-block w-[0.7rem] text-center text-[0.95em] leading-none text-ghostindigo-700 opacity-0 group-hover:opacity-100"
                  aria-hidden="true"
                >
                  ↗
                </span>
              </a>
              {talk.secondaryHref ? (
                <a
                  class={actionClasses}
                  href={talk.secondaryHref}
                  target="_blank"
                  rel="noreferrer"
                >
                  <span class={slidesIconWrapClasses} aria-hidden="true">
                    <Presentation
                      aria-hidden="true"
                      size={13}
                      stroke-width={2}
                      class={actionIconClasses}
                    />
                  </span>
                  <span class={actionLabelClasses}>{talk.secondaryLabel}</span>
                  <span
                    class="hover-accent-arrow inline-block w-[0.7rem] text-center text-[0.95em] leading-none text-ghostindigo-700 opacity-0 group-hover:opacity-100"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </a>
              ) : null}
            </div>
          </div>
        </div>
      </li>
    ))
  }
</ul>
